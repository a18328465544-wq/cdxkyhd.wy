{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:pagination": "node --import tsx src/lib/pagination.test.ts",
    "test:performance": "node --import tsx --test src/lib/visiblePolling.test.ts src/lib/api.test.ts src/components/performanceRender.test.tsx",
    "test:review-fixes": "node --import tsx src/lib/review-fixes.test.ts",
    "test:inventory-categories": "node --import tsx src/lib/inventoryCategories.test.ts",
    "test:part-search": "node --import tsx --test src/lib/partSearch.test.ts",
    "test:part-select-render": "node --import tsx --test src/components/searchablePartSelectRender.test.tsx",
    "test:controls": "node --import tsx --test src/components/ui/controls.test.tsx",
    "test:workflows": "node --import tsx --test src/lib/buildStarters.test.ts src/components/workflowRender.test.tsx",
    "test:about": "node --import tsx --test src/components/aboutUsRender.test.tsx",
    "test:contact": "node --import tsx src/lib/contact.test.ts",
    "test:gpu-ranking": "node --import tsx src/data/gpuRanking.test.ts && node --import tsx --test src/components/gpuRankingRender.test.tsx",
    "test:pricing": "node --import tsx --test src/lib/pricing.test.ts src/lib/recyclingPrices.test.ts src/components/recyclingPriceRender.test.tsx",
    "test:routes": "node --import tsx --test src/routes/pageRoutes.test.ts src/routes/clientNavigation.test.ts src/routes/routeTransition.test.tsx",
    "test:rental-calculator": "node --import tsx --test src/lib/rentalCalculator.test.ts",
    "test:gpu-daily": "node --import tsx --test src/components/gpuDailyRender.test.tsx src/lib/gpuPriceHistory.test.ts",
    "test:prl": "node --import tsx --test src/lib/prlCalculator.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cdxkyhd/shared": "file:../shared",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "chart.js": "4.6.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "7.18.5",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.5"
  }
}
