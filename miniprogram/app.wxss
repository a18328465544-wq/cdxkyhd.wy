page {
  min-height: 100%;
  background: #f3f5f7;
  color: #17211f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

button {
  border-radius: 12rpx;
  font-size: 28rpx;
}

button::after {
  border: 0;
}

.page {
  padding: 28rpx 28rpx 48rpx;
}

.page-title {
  display: block;
  margin: 8rpx 0 8rpx;
  color: #17211f;
  font-size: 40rpx;
  font-weight: 700;
}

.page-subtitle {
  display: block;
  margin-bottom: 28rpx;
  color: #707a78;
  font-size: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 18rpx;
  color: #293431;
  font-size: 29rpx;
  font-weight: 650;
}

.surface {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 18rpx rgba(22, 39, 34, 0.045);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #77817e;
  font-size: 23rpx;
}

.primary-button {
  color: #ffffff;
  background: #147d64;
}

.secondary-button {
  color: #147d64;
  background: #e7f3ef;
}

.danger-text {
  color: #c44b42;
}

.link-text {
  color: #147d64;
  font-size: 23rpx;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e2e8e5;
  border-radius: 12rpx;
  background: #ffffff;
  color: #17211f;
}

.field-label {
  display: block;
  margin: 18rpx 0 10rpx;
  color: #4e5955;
  font-size: 24rpx;
}

.empty {
  padding: 48rpx 20rpx;
  color: #858e8b;
  text-align: center;
}
