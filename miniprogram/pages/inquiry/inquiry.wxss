.product-summary {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx;
}

.product-mark {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #e8f1ee;
  color: #147d64;
  font-size: 21rpx;
  font-weight: 700;
}

.product-info {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 9rpx;
}

.product-name {
  color: #27332e;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
}

.product-meta,
.product-stock {
  color: #7b8581;
  font-size: 21rpx;
}

.product-price {
  color: #147d64;
  font-size: 26rpx;
  font-weight: 700;
}

.inquiry-form {
  margin-top: 18rpx;
  padding: 24rpx;
}

.note-input {
  height: 150rpx;
  padding-top: 18rpx;
  line-height: 1.5;
}

.submit-button {
  margin-top: 28rpx;
}

.consent-note {
  display: block;
  margin-top: 18rpx;
  color: #858e8b;
  font-size: 20rpx;
  line-height: 1.6;
}
