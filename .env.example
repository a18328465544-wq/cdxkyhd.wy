# Backend API gateway port.
PORT=3001

# Set to 1 only when requests always pass through one trusted reverse proxy.
TRUST_PROXY=0

# Optional: real ERP Open API base URL.
# When set, backend API routes read inventory and sync estimated sell prices from this ERP service.
ERP_BASE_URL=https://gpu-erp.cdgpu.cn/api/open

# Optional: ERP bearer token.
# Fill this with the ERP server OPEN_API_TOKEN. Do not commit the real token.
ERP_API_KEY=

# Optional: comma-separated frontend origins allowed by the backend.
# Example: CORS_ORIGIN=http://localhost:5173,https://cdgpu.cn,https://www.cdgpu.cn
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://cdgpu.cn,https://www.cdgpu.cn

# Frontend production API URL.
# Leave empty in local dev so Vite proxies /api to http://localhost:3001.
VITE_API_BASE_URL=

# Frontend dev proxy target.
VITE_API_PROXY_TARGET=http://localhost:3001

# Forum data is separate from ERP inventory. Keep this directory on persistent storage.
FORUM_DATA_DIR=./data/forum

# Keep a stable random secret in production; at least 32 bytes. Never commit real values.
FORUM_SESSION_SECRET=

# Moderator password; at least 16 characters. Leave empty until configured securely.
FORUM_ADMIN_PASSWORD=

# Geekbench Browser API. Request an API key from Primate Labs before enabling sync.
# Set the permission flag to true only after confirming the result redistribution terms.
GEEKBENCH_BROWSER_API_KEY=
GEEKBENCH_REDISPLAY_ALLOWED=false
GEEKBENCH_RANKING_CACHE_FILE=./data/geekbench-ranking-cache.json

# 3DMark scores are never scraped from the public results pages. Point this to an
# authorized feed/export file and enable display only after confirming its license.
THREE_DMARK_REDISPLAY_ALLOWED=false
THREE_DMARK_RANKING_DATA_FILE=
THREE_DMARK_RANKING_CACHE_FILE=./data/3dmark-ranking-cache.json

# Optional Baidu Tongji site ID (the 32-character ID in the generated hm.js URL).
# The frontend tracker runs in production builds only.
VITE_BAIDU_TONGJI_ID=

# Optional HTTPS store URLs. Configured links appear in the contact section and footer.
VITE_XIANYU_URL=
VITE_TAOBAO_URL=

# Optional CoinGecko Demo API key for Pearl price requests. Server only, never VITE_.
COINGECKO_DEMO_API_KEY=
# 显卡日报：独立采价模块导出的公开文件。生产环境请使用持久目录中的绝对路径。
GPU_DAILY_PRICE_FILE=

# Optional persistent directory containing previous fingerprinted assets for release continuity.
STATIC_ASSET_FALLBACK_DIR=
# Anonymous numeric Web Vitals only; no cookies, search terms or form values.
VITE_PERFORMANCE_SAMPLE_RATE=0.1
PERFORMANCE_DATA_DIR=./data/performance
# Set the exact public origin in production (no trailing slash).
PERFORMANCE_SITE_ORIGIN=https://cdgpu.cn
